{
  "name": "a-pedra-do-sol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RPG de sobrevivencia com risco de verdade, feito para qualquer pessoa jogar",
  "scripts": {
    "dev": "vite",
    "build": "npm run verificar && tsc --noEmit && vite build",
    "preview": "vite preview",
    "arte": "python3 arte/gerar.py",
    "som": "python3 som/gerar.py",
    "app": "concurrently -k \"npm run dev\" \"node ferramentas/abrir-app.mjs\"",
    "app:build": "npm run build && electron-builder",
    "app:mac": "npm run build && electron-builder --mac",
    "app:win": "npm run build && electron-builder --win",
    "app:linux": "npm run build && electron-builder --linux",
    "auditar": "npm run build && node ferramentas/auditar-ui.mjs",
    "auditar-celular": "npm run build && node ferramentas/auditar-celular.mjs",
    "conferir": "node ferramentas/conferir-personagens.mjs",
    "folha": "python3 ferramentas/folha-de-personagens.py",
    "bestiario": "python3 ferramentas/folha-do-bestiario.py",
    "verificar": "node ferramentas/verificar.mjs",
    "criatura": "node ferramentas/conferir-criatura.mjs",
    "condicoes": "node ferramentas/conferir-condicoes.mjs",
    "derrota": "node ferramentas/conferir-derrota.mjs",
    "teste": "node ferramentas/conferir-teste.mjs",
    "contraste": "python3 ferramentas/contraste.py",
    "ambiente": "node ferramentas/ambiente.mjs",
    "frente-check": "node ferramentas/frente-check.mjs",
    "icones": "python3 arte/icones.py",
    "dashboard": "npm run arte && node --import ./ferramentas/registrar-resolver-ts.mjs ferramentas/dashboard-visual.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  },
  "main": "app/principal.cjs",
  "build": {
    "appId": "br.aurora.reino",
    "productName": "A Pedra do Sol",
    "files": [
      "dist/**/*",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "entregas"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}

{
  "name": "reino-de-aurora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jogo de aventura do Reino de Aurora, feito para o Lele jogar",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "arte": "python3 arte/gerar.py",
    "app": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "app:build": "npm run build && electron-builder",
    "app:mac": "npm run build && electron-builder --mac",
    "app:win": "npm run build && electron-builder --win",
    "app:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  },
  "main": "app/principal.cjs",
  "build": {
    "appId": "br.aurora.reino",
    "productName": "Reino de Aurora",
    "files": [
      "dist/**/*",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "entregas"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
